generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}


// --------------------------------------
// ENUMS
// --------------------------------------

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

// --------------------------------------
// USER MODEL
// --------------------------------------

model User {
  id           String @id @default(uuid())
  name         String
  phone        String @unique
  email        String @unique
  passwordHash String

  cartItems CartItem[]
  favorites Favorite[]
  addresses Address[]
  orders    Orders[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------
// ADDRESS MODEL
// --------------------------------------

model Address {
  id           String      @id @default(uuid())
  userId       String
  fullName     String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String      @default("India")
  phone        String
  type         AddressType @default(SHIPPING)
  isDefault    Boolean     @default(false)

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Orders[] @relation("ShippingAddress")
  billingOrders  Orders[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --------------------------------------
// CART ITEM MODEL
// --------------------------------------

model CartItem {
  id        String @id @default(uuid())
  userId    String
  productId String
  variantId String @default("default") // 👈 Changed from String? to avoid NULL composite key bugs
  quantity  Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

// --------------------------------------
// FAVORITE / WISHLIST MODEL
// --------------------------------------

model Favorite {
  id        String @id @default(uuid())
  userId    String
  productId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// --------------------------------------
// ORDERS MODEL
// --------------------------------------

model Orders {
  id          String      @id @default(uuid())
  userId      String
  totalAmount Decimal     @db.Decimal(10, 2)
  orderStatus OrderStatus @default(PENDING)

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  shippingAddressId String
  billingAddressId  String?

  // Address relations protected from accidental deletion with Restrict
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address  @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict) // 👈 Prevents breaking orders on address delete
  billingAddress  Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --------------------------------------
// ORDER ITEM MODEL
// --------------------------------------

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  productName String // 👈 Stores product name snapshot at time of purchase
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(10, 2)

  order Orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
